TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SUB2_API_URL=
SUB2_API_KEY=
SUB2_PROXY_TEMPLATE_JSON=

DATABASE_PATH=/app/data/app.db
