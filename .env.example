# 运行环境，生产部署保持 production。
NODE_ENV=production

# FastAPI 后端监听地址；本地只绑定 127.0.0.1，由 Next.js 转发 /api 请求。
HOST=127.0.0.1
PORT=8000

# Next.js 前端监听地址；Docker 对外暴露的是 FRONTEND_PORT。
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000

# Next.js 服务端转发 API 请求时访问的后端地址。
BACKEND_URL=http://127.0.0.1:8000

# Web 管理后台密码，浏览器请求会通过 X-Admin-Password 或 token 传给后端。
ADMIN_PASSWORD=admin@123456

# Docker 宿主机映射端口，访问地址通常是 http://localhost:${HOST_PORT}。
HOST_PORT=3000

# 宿主机数据目录；docker-compose 会挂载到容器内 /app/data。
DATA_DIR=./data

# 本地后端直接启动时使用的 SQLite 文件路径；Docker 内部固定使用 /app/data/app.db。
DATABASE_PATH=./data/app.db
